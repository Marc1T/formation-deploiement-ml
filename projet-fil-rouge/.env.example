# GEMINI_API_KEY=                        # clé Google AI Studio (séance 3)
# GEMINI_MODEL=gemini-flash-latest
# MODEL_URL=                             # téléchargement du modèle si absent (parcours avancé)

# --- MLflow ---
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db          # défaut (fichier local)
# MLFLOW_TRACKING_URI=http://localhost:5000        # serveur lancé par docker compose
